<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.12" />
    <PackageReference Include="OpenAI" Version="2.14.0" />
  </ItemGroup>

  <ItemGroup>
    <Content Remove="wwwroot\**" />
    <Content Update="appsettings.Development.json" CopyToPublishDirectory="Never" />
  </ItemGroup>

  <Target Name="BuildFrontend" AfterTargets="ComputeFilesToPublish">
    <Exec Command="npm run build" WorkingDirectory="$(MSBuildProjectDirectory)\..\..\frontend" />
    <ItemGroup>
      <_FrontendFiles Include="$(MSBuildProjectDirectory)\wwwroot\**" />
      <ResolvedFileToPublish Include="@(_FrontendFiles->'%(FullPath)')">
        <RelativePath>wwwroot\%(RecursiveDir)%(Filename)%(Extension)</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
        <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>

</Project>
